# Uploaded files only (product images, logos, brochures, certificates). Never execute anything here.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>

# Certificate and brochure PDFs open in the browser tab instead of downloading.
AddType application/pdf .pdf
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(?i:pdf)$">
        Header set Content-Disposition "inline"
    </FilesMatch>
</IfModule>
